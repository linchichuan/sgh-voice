<?xml version="1.0" encoding="utf-8"?>
<!-- SGH Voice：單一系統 IME，鍵盤內切換語音、注音、日文與英文。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/keyboard_bg"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/mode_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_keyboard_brand"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/keyboard_brand"
            android:drawableStart="@drawable/ic_sgh_voice_mark"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/keyboard_brand_short"
            android:textColor="@color/key_text"
            android:textSize="10sp" />

        <LinearLayout
            android:id="@+id/mode_group"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/keyboard_mode_strip_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="0dp">

            <TextView
                android:id="@+id/btn_mode_voice"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:contentDescription="@string/mode_voice_desc"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/mode_voice"
                android:textColor="@color/keyboard_selected_text"
                android:includeFontPadding="false"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_mode_zhuyin"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:contentDescription="@string/mode_zhuyin_desc"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/mode_zhuyin"
                android:textColor="@color/keyboard_muted_text"
                android:includeFontPadding="false"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_mode_japanese"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:contentDescription="@string/mode_japanese_desc"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/mode_japanese"
                android:textColor="@color/keyboard_muted_text"
                android:includeFontPadding="false"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_mode_english"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:contentDescription="@string/mode_english_desc"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/mode_english"
                android:textColor="@color/keyboard_muted_text"
                android:includeFontPadding="false"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_next_keyboard"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/system_switch_bg"
            android:contentDescription="@string/key_next_keyboard_desc"
            android:elevation="1dp"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_keyboard_switch" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/keyboard_content_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <LinearLayout
        android:id="@+id/panel_voice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="@dimen/voice_panel_vertical_padding"
        android:paddingEnd="12dp"
        android:paddingBottom="@dimen/voice_panel_vertical_padding">

        <LinearLayout
            android:id="@+id/voice_task_switch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/voice_task_switch_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/btn_voice_dictation"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/voice_task_selected_bg"
                android:clickable="true"
                android:contentDescription="@string/voice_task_dictation_desc"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:focusable="true"
                android:text="@string/voice_task_dictation"
                android:textColor="@color/voice_task_selected_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_voice_compose"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/voice_task_unselected_bg"
                android:clickable="true"
                android:contentDescription="@string/voice_task_compose_desc"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:focusable="true"
                android:text="@string/voice_task_compose"
                android:textColor="@color/voice_task_unselected_text"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_marginTop="@dimen/voice_status_top_margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/voice_state_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/status_dot_bg" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/status_idle"
                android:textColor="@color/status_text"
                android:textSize="15sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/voice_capture_area"
            android:layout_width="match_parent"
            android:layout_height="@dimen/voice_mic_diameter"
            android:layout_marginTop="@dimen/voice_mic_top_margin">

        <!-- One touch target: feedback and finish action share the same circle. -->
        <FrameLayout
            android:id="@+id/mic_outer_ring"
            android:layout_width="@dimen/voice_mic_diameter"
            android:layout_height="@dimen/voice_mic_diameter"
            android:layout_gravity="center"
            android:background="@drawable/mic_outer_ring_bg"
            android:elevation="2dp"
            android:padding="3dp">

            <FrameLayout
                android:id="@+id/btn_mic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/mic_button_bg"
                android:clickable="true"
                android:contentDescription="@string/mic_button_desc"
                android:focusable="true"
                android:importantForAccessibility="yes">

                <com.shingihou.sghvoice.ime.AudioWaveformView
                    android:id="@+id/audio_waveform"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:visibility="invisible" />

                <ImageView
                    android:id="@+id/mic_action_icon"
                    android:layout_width="@dimen/voice_mic_icon_size"
                    android:layout_height="@dimen/voice_mic_icon_size"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="@dimen/voice_mic_icon_top_margin"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_mic" />

                <TextView
                    android:id="@+id/mic_action_label"
                    android:layout_width="@dimen/voice_mic_label_width"
                    android:layout_height="@dimen/voice_mic_label_height"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="@dimen/voice_mic_label_bottom_margin"
                    android:autoSizeMaxTextSize="14sp"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:text="@string/mic_action_start"
                    android:textColor="@color/mic_text_recording"
                    android:textSize="14sp" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/draft_preview_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/voice_compose_secondary_bg"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:overScrollMode="ifContentScrolls">

                <TextView
                    android:id="@+id/tv_draft_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:textColor="@color/key_text"
                    android:textSize="15sp" />
            </androidx.core.widget.NestedScrollView>

            <TextView
                android:id="@+id/btn_draft_preview_close"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/voice_task_unselected_bg"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/voice_draft_preview_close"
                android:textColor="@color/voice_compose_action_text"
                android:textSize="13sp" />
        </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/compose_action_row"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/btn_compose_continue"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1.2"
                android:background="@drawable/voice_compose_secondary_bg"
                android:clickable="true"
                android:contentDescription="@string/voice_compose_continue"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/voice_compose_continue"
                android:textColor="@color/voice_compose_action_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_compose_generate"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1.5"
                android:background="@drawable/voice_compose_primary_bg"
                android:clickable="true"
                android:contentDescription="@string/voice_compose_generate"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/voice_compose_generate"
                android:textColor="@color/voice_compose_primary_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_compose_clear"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/voice_compose_secondary_bg"
                android:clickable="true"
                android:contentDescription="@string/voice_compose_clear"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/voice_compose_clear"
                android:textColor="@color/voice_compose_action_text"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pending_insert_row"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/btn_pending_insert"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1.4"
                android:background="@drawable/voice_compose_primary_bg"
                android:clickable="true"
                android:contentDescription="@string/voice_pending_insert"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/voice_pending_insert"
                android:textColor="@color/voice_compose_primary_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_pending_discard"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/voice_compose_secondary_bg"
                android:clickable="true"
                android:contentDescription="@string/voice_pending_discard"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/voice_pending_discard"
                android:textColor="@color/voice_compose_action_text"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/translation_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/mode_switch_bg"
            android:orientation="vertical"
            android:padding="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/translation_picker_title"
                android:textColor="@color/key_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_translation_zh_hant"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/mode_unselected_bg"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/translation_language_zh_hant"
                    android:textColor="@color/keyboard_muted_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip_translation_ja"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/mode_unselected_bg"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/translation_language_ja"
                    android:textColor="@color/keyboard_muted_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip_translation_en"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/mode_unselected_bg"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/translation_language_en"
                    android:textColor="@color/keyboard_muted_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip_translation_ko"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/mode_unselected_bg"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/translation_language_ko"
                    android:textColor="@color/keyboard_muted_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:paddingTop="2dp">

                <TextView
                    android:id="@+id/btn_translation_cancel"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/key_special_bg"
                    android:gravity="center"
                    android:text="@string/translation_cancel"
                    android:textColor="@color/key_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_translation_start"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1.5"
                    android:background="@drawable/key_enter_bg"
                    android:gravity="center"
                    android:text="@string/translation_start"
                    android:textColor="@color/key_text_enter"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btn_draft_preview"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/voice_compose_secondary_bg"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/voice_draft_preview"
            android:textColor="@color/voice_compose_action_text"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_voice_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/voice_toggle_hint"
            android:textColor="@color/keyboard_muted_text"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_manual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/input_strip"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/composition_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="3dp"
            android:paddingTop="3dp"
            android:paddingEnd="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/tv_composition"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/composition_chip_bg"
                android:ellipsize="start"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:hint="@string/zhuyin_composition_hint"
                android:maxWidth="96dp"
                android:minWidth="48dp"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/key_text"
                android:textColorHint="@color/keyboard_muted_text"
                android:visibility="gone"
                android:textSize="17sp" />

            <HorizontalScrollView
                android:id="@+id/candidate_scroller"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/candidate_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <ImageButton
                android:id="@+id/btn_expand_candidates"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/candidate_expand_bg"
                android:contentDescription="@string/candidate_expand_desc"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_expand_more"
                android:visibility="gone" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/candidate_expanded_panel"
            android:layout_width="match_parent"
            android:layout_height="192dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/composition_bg"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:padding="4dp"
            android:scrollbars="vertical"
            android:visibility="gone">

            <GridLayout
                android:id="@+id/candidate_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="3"
                android:orientation="horizontal"
                android:useDefaultMargins="false" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/manual_key_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/voice_action_row"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_layer"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.15"
            android:background="@drawable/key_special_bg"
            android:elevation="1dp"
            android:gravity="center"
            android:contentDescription="@string/key_ideographic_comma_desc"
            android:text="@string/key_ideographic_comma"
            android:textColor="@color/key_text"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btn_comma"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/key_bg"
            android:elevation="1dp"
            android:gravity="center"
            android:text="@string/key_comma"
            android:textColor="@color/key_text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btn_space"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="2.1"
            android:background="@drawable/key_bg"
            android:elevation="1dp"
            android:gravity="center"
            android:text="@string/key_space"
            android:textColor="@color/key_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_period"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/key_bg"
            android:elevation="1dp"
            android:gravity="center"
            android:text="@string/key_period"
            android:textColor="@color/key_text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btn_backspace"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.1"
            android:background="@drawable/key_special_bg"
            android:contentDescription="@string/key_backspace_desc"
            android:elevation="1dp"
            android:gravity="center"
            android:text="@string/key_backspace"
            android:textColor="@color/key_text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btn_enter"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:layout_weight="1.1"
            android:background="@drawable/key_enter_bg"
            android:contentDescription="@string/key_enter_desc"
            android:elevation="1dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/key_enter"
            android:textColor="@color/key_text_enter"
            android:textSize="27sp" />
    </LinearLayout>

</LinearLayout>
