<?xml version="1.0" encoding="utf-8"?>
<!-- SGH Voice：單一系統 IME，鍵盤內切換語音、注音、日文與英文。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/keyboard_bg"
    android:orientation="vertical"
    android:paddingStart="7dp"
    android:paddingTop="8dp"
    android:paddingEnd="7dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:id="@+id/mode_bar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_keyboard_brand"
            android:layout_width="84dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/keyboard_brand"
            android:drawableStart="@drawable/ic_sgh_voice_mark"
            android:drawablePadding="5dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/keyboard_brand"
            android:textColor="@color/key_text"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/mode_group"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/mode_switch_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btn_mode_voice"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1.1"
                android:contentDescription="@string/mode_voice_desc"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/mode_voice"
                android:textColor="@color/keyboard_selected_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_mode_zhuyin"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="0.9"
                android:contentDescription="@string/mode_zhuyin_desc"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/mode_zhuyin"
                android:textColor="@color/keyboard_muted_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_mode_japanese"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="0.9"
                android:contentDescription="@string/mode_japanese_desc"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/mode_japanese"
                android:textColor="@color/keyboard_muted_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_mode_english"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1.1"
                android:contentDescription="@string/mode_english_desc"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/mode_english"
                android:textColor="@color/keyboard_muted_text"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_next_keyboard"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/system_switch_bg"
            android:contentDescription="@string/key_next_keyboard_desc"
            android:elevation="1dp"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_keyboard_switch" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_voice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/voice_panel_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="15dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/voice_state_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/status_dot_bg" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/status_idle"
                android:textColor="@color/status_text"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_mic"
            android:layout_width="224dp"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/mic_button_bg"
            android:contentDescription="@string/mic_button_desc"
            android:drawablePadding="10dp"
            android:elevation="2dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/mic_action_start"
            android:textColor="@color/key_text_enter"
            android:textSize="17sp"
            app:drawableStartCompat="@drawable/ic_mic" />

        <TextView
            android:id="@+id/tv_voice_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/voice_toggle_hint"
            android:textColor="@color/keyboard_muted_text"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_manual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/input_strip"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/composition_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="3dp"
            android:paddingTop="3dp"
            android:paddingEnd="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/tv_composition"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/composition_chip_bg"
                android:ellipsize="start"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:hint="@string/zhuyin_composition_hint"
                android:maxWidth="96dp"
                android:minWidth="48dp"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/key_text"
                android:textColorHint="@color/keyboard_muted_text"
                android:visibility="gone"
                android:textSize="17sp" />

            <HorizontalScrollView
                android:id="@+id/candidate_scroller"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/candidate_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <ImageButton
                android:id="@+id/btn_expand_candidates"
                android:layout_width="42dp"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/candidate_expand_bg"
                android:contentDescription="@string/candidate_expand_desc"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_expand_more"
                android:visibility="gone" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/candidate_expanded_panel"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/composition_bg"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:padding="4dp"
            android:scrollbars="vertical"
            android:visibility="gone">

            <GridLayout
                android:id="@+id/candidate_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="3"
                android:orientation="horizontal"
                android:useDefaultMargins="false" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/manual_key_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/voice_action_row"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_layer"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.15"
            android:background="@drawable/key_special_bg"
            android:elevation="1dp"
            android:gravity="center"
            android:text="@string/key_numbers"
            android:textColor="@color/key_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_comma"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/key_bg"
            android:elevation="1dp"
            android:gravity="center"
            android:text="@string/key_comma"
            android:textColor="@color/key_text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btn_space"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="2.1"
            android:background="@drawable/key_bg"
            android:elevation="1dp"
            android:gravity="center"
            android:text="@string/key_space"
            android:textColor="@color/key_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_period"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/key_bg"
            android:elevation="1dp"
            android:gravity="center"
            android:text="@string/key_period"
            android:textColor="@color/key_text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btn_backspace"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.1"
            android:background="@drawable/key_special_bg"
            android:contentDescription="@string/key_backspace_desc"
            android:elevation="1dp"
            android:gravity="center"
            android:text="@string/key_backspace"
            android:textColor="@color/key_text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btn_enter"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:layout_weight="1.1"
            android:background="@drawable/key_enter_bg"
            android:contentDescription="@string/key_enter_desc"
            android:elevation="1dp"
            android:gravity="center"
            android:text="@string/key_enter"
            android:textColor="@color/key_text_enter"
            android:textSize="18sp" />
    </LinearLayout>

</LinearLayout>
