    <!-- Usage Guide -->
    <string name="usage_title">Usage Guide</string>
    <string name="usage_step1">1. Tap the microphone for normal dictation. Hold it to choose 1–4 translation languages. Hold again while recording to cancel safely.</string>
    <string name="usage_step2">2. Switch between Zhuyin, Japanese romaji, and English. Zhuyin includes phrases, local completions, and user-defined readings.</string>
    <string name="usage_step3">3. Voice mode handles mixed Chinese, Japanese, and English; Chinese output is Traditional Chinese.</string>
    <string name="usage_step4">4. Frequently selected candidates move forward. Short voice-text corrections in the same field are learned locally.</string>
    <string name="jmdict_attribution">Japanese common-word candidates: JMdict / EDRDG (CC BY-SA 4.0)</string>
